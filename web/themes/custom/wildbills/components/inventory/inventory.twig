{#
  demo_notices is not a prop: the wildbills_site module hands it to every
  wildbills component from the dealership details' demo switch. Everything
  the pop-up shows is filled in by inventory.js from the card's data, with
  textContent.
#}
{%- set close_icon -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
{%- endset -%}
{%- macro k(n) %}{{ n % 1000 == 0 ? n // 1000 : n / 1000 }}k{% endmacro -%}
<div class="wb-inventory" data-wb-inventory>
  {{ heading }}
  <div class="wb-wrap wb-inv-layout">
    <aside class="wb-filters" id="wb-filters" aria-label="{{ 'Filter vehicles'|t }}" data-wb-filters>
      <div class="wb-filters-head"><h2>{{ 'Filters'|t }}</h2><button class="wb-link-btn" type="button" data-wb-reset>{{ 'Reset'|t }}</button></div>
      <div class="wb-field">
        <label for="wb-q">{{ 'Search'|t }}</label>
        <input class="wb-input" id="wb-q" type="search" placeholder="{{ 'Make, model or color'|t }}" autocomplete="off" data-wb-search>
      </div>
      <div class="wb-field">
        <span class="wb-field-label" id="wb-type-label">{{ 'Body style'|t }}</span>
        <div class="wb-seg" role="group" aria-labelledby="wb-type-label" data-wb-types>
          <button type="button" data-type="" aria-pressed="true">{{ 'All'|t }}</button>
          {{- types -}}
        </div>
      </div>
      <div class="wb-field">
        <label for="wb-make">{{ 'Make'|t }}</label>
        <select class="wb-select" id="wb-make" data-wb-make><option value="">{{ 'All makes'|t }}</option>{{ makes }}</select>
      </div>
      <div class="wb-field">
        <label for="wb-max-price">{{ 'Max price'|t }} <output for="wb-max-price" data-wb-out="price"></output></label>
        <input type="range" id="wb-max-price" min="{{ price_min }}" max="{{ price_max }}" step="{{ price_step|default(500) }}" value="{{ price_max }}" data-wb-range="price">
        <div class="wb-range-ends"><span>${{ _self.k(price_min) }}</span><span>${{ _self.k(price_max) }}</span></div>
      </div>
      <div class="wb-field">
        <label for="wb-min-year">{{ 'Year or newer'|t }} <output for="wb-min-year" data-wb-out="year"></output></label>
        <input type="range" id="wb-min-year" min="{{ year_min }}" max="{{ year_max }}" step="1" value="{{ year_min }}" data-wb-range="year">
        <div class="wb-range-ends"><span>{{ year_min }}</span><span>{{ year_max }}</span></div>
      </div>
      <div class="wb-field">
        <label for="wb-max-miles">{{ 'Max mileage'|t }} <output for="wb-max-miles" data-wb-out="miles"></output></label>
        <input type="range" id="wb-max-miles" min="{{ miles_min }}" max="{{ miles_max }}" step="{{ miles_step|default(5000) }}" value="{{ miles_max }}" data-wb-range="miles">
        <div class="wb-range-ends"><span>{{ _self.k(miles_min) }}</span><span>{{ _self.k(miles_max) }}</span></div>
      </div>
    </aside>

    <div>
      <div class="wb-toolbar">
        <p class="wb-count" role="status" aria-live="polite" data-wb-count>{{ total }} {{ total == 1 ? 'vehicle'|t : 'vehicles'|t }} <span>{{ 'of @total'|t({'@total': total}) }}</span></p>
        <div class="wb-toolbar-right">
          <button class="wb-btn wb-btn-ghost wb-btn-sm wb-filter-toggle" type="button" aria-expanded="false" aria-controls="wb-filters" data-wb-filter-toggle>{{ 'Filters'|t }}</button>
          <label class="wb-sr-only" for="wb-sort">{{ 'Sort by'|t }}</label>
          <select class="wb-select" id="wb-sort" data-wb-sort>
            <option value="featured">{{ 'Featured first'|t }}</option>
            <option value="price-asc">{{ 'Price: low to high'|t }}</option>
            <option value="price-desc">{{ 'Price: high to low'|t }}</option>
            <option value="year-desc">{{ 'Newest first'|t }}</option>
            <option value="miles-asc">{{ 'Lowest mileage'|t }}</option>
          </select>
        </div>
      </div>
      <div class="wb-active-chips" aria-label="{{ 'Active filters'|t }}" data-wb-chips></div>
      <div data-wb-cards>{{ include('wildbills:card_grid', { kind: 'cars', items: cards }, with_context = false) }}</div>
      <div class="wb-empty" data-wb-empty{{ total > 0 ? ' hidden' }}>
        <div class="wb-empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M8 11h6"/></svg></div>
        <h2>{{ 'Nothing matches that combination.'|t }}</h2>
        <p>{{ "Loosen a filter or two, or tell us what you're after and we'll keep an eye out."|t }}</p>
        <div class="wb-empty-actions"><button class="wb-btn wb-btn-primary" type="button" data-wb-reset>{{ 'Reset all filters'|t }}</button><a class="wb-btn wb-btn-ghost" href="{{ path('<front>') }}contact?topic=Vehicle%20search">{{ 'Ask us to look'|t }}</a></div>
      </div>
    </div>
  </div>

  <template data-wb-close-icon>{{ close_icon }}</template>
  <dialog class="wb-detail" aria-labelledby="wb-detail-title" data-wb-dialog>
    <div class="wb-detail-inner">
      <button class="wb-close-btn" type="button" aria-label="{{ 'Close details'|t }}" data-wb-close>{{ close_icon }}</button>
      <div class="wb-detail-grid">
        <div class="wb-detail-media"><img alt="" data-wb-d="img"></div>
        <div class="wb-detail-body">
          <div>
            <div class="wb-car-year" data-wb-d="kicker"></div>
            <h2 id="wb-detail-title" data-wb-d="name"></h2>
            <span class="wb-chip wb-chip-pending wb-detail-chip" data-wb-d="pending" hidden>{{ 'Sale pending'|t }}</span>
          </div>
          <div class="wb-price wb-price--detail"><span data-wb-d="price"></span><small>{{ demo_notices ? 'Sample listed price'|t : 'Listed price'|t }}</small></div>
          <dl class="wb-spec-table">
            <div><dt>{{ 'Mileage'|t }}</dt><dd data-wb-d="miles"></dd></div>
            <div><dt>{{ 'Year'|t }}</dt><dd data-wb-d="year"></dd></div>
            <div><dt>{{ 'Body style'|t }}</dt><dd data-wb-d="type"></dd></div>
            <div><dt>{{ 'Color'|t }}</dt><dd data-wb-d="color"></dd></div>
            <div><dt>{{ 'Make'|t }}</dt><dd data-wb-d="make"></dd></div>
            <div><dt>{{ 'Condition'|t }}</dt><dd data-wb-d="condition"></dd></div>
          </dl>
          {%- if demo_notices %}
          <p class="wb-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg><span>{{ 'Sample listing for demonstration. Photo is illustrative. Confirm availability, history and final price with the dealership.'|t }}</span></p>
          {%- endif %}
          <div class="wb-detail-actions">
            <a class="wb-btn wb-btn-primary" href="{{ path('<front>') }}contact" data-wb-d="ask">{{ 'Ask about this car'|t }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            {%- if phone_href %}
            {{ include('wildbills:button', { label: demo_notices ? 'Call (sample)'|t : 'Call'|t, url: phone_href, variant: 'ghost', icon: 'phone' }, with_context = false) }}
            {%- endif %}
          </div>
        </div>
      </div>
    </div>
  </dialog>
</div>
