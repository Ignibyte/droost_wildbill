{%- set classes = ['wb-btn', 'wb-btn-' ~ (variant|default('primary')), (size|default('md')) == 'sm' ? 'wb-btn-sm'] -%}
<a class="{{ classes|filter(c => c)|join(' ') }}" href="{{ url }}"{% if new_tab %} target="_blank" rel="noopener"{% endif %}>
  {%- if icon == 'phone' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg> {% endif -%}
  {{ label }}
  {%- if icon == 'arrow' %} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{% endif -%}
</a>
