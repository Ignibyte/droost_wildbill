{%- if placement == 'mobile' -%}
<a href="{{ url }}"{% if current %} aria-current="page"{% endif %}>{{ title }} <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
{%- else -%}
<li><a href="{{ url }}"{% if current %} aria-current="page"{% endif %}>{{ title }}</a></li>
{%- endif -%}
