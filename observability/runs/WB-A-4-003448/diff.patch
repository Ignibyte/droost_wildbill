+/**
+ * Makes the Location & Hours page and keeps /location.html answering.
+ *
+ * The page is an empty Canvas page at /location with the source's title and
+ * description; droost/canvas/apply-location.sh writes its components. Safe
+ * to run again: the page is found by its alias, the redirect by its source
+ * path, and nothing that exists is changed.
+ */
+function wildbills_site_deploy_r03_location(): string {
+  $alias = \Drupal::service('path_alias.repository')->lookupByAlias('/location', 'en');
+  $created = 0;
+  if (!$alias) {
+    Page::create([
+      'title' => 'Location & Hours',
+      'description' => "Opening hours, address and map links for visiting Wild Bill's Used Cars. Sample location details for this demo website.",
+      'path' => ['alias' => '/location'],
+      'status' => TRUE,
+    ])->save();
+    $created++;
+  }
+
+  $redirects = \Drupal::entityTypeManager()->getStorage('redirect');
+  if (!$redirects->loadByProperties(['redirect_source__path' => 'location.html'])) {
+    Redirect::create([
+      'redirect_source' => ['path' => 'location.html'],
+      'redirect_redirect' => ['uri' => 'internal:/location'],
+      'status_code' => 301,
+      'language' => 'und',
+    ])->save();
+  }
+
+  return sprintf('Location & Hours: %d page(s) created.', $created);
+}
